/* Prarup: calm neutrals, one accent (orange, from the project brief),
   red and amber only where something needs attention. */

QMainWindow, QWidget { background: #f6f5f2; color: #24221f; font-size: 13px; }

QToolBar { background: #ffffff; border: none; border-bottom: 1px solid #e3e0da;
           padding: 6px 10px; spacing: 6px; }
QToolBar QToolButton { background: transparent; border: 1px solid transparent; border-radius: 6px;
                       padding: 6px 12px; color: #24221f; }
QToolBar QToolButton:hover { background: #f1eee9; border-color: #e3e0da; }
QToolBar QToolButton:disabled { color: #b5b0a8; }
QToolBar QToolButton#primary { background: #e8590c; color: #ffffff; font-weight: 600; }
QToolBar QToolButton#primary:hover { background: #d9480f; }
QToolBar QToolButton#primary:disabled { background: #f0c3a8; color: #ffffff; }
QLabel#brand { font-size: 16px; font-weight: 700; color: #24221f; padding-right: 10px; }
QLabel#paperName { color: #6b665e; padding-left: 4px; }

QSplitter::handle { background: #e3e0da; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QTreeWidget, QListWidget, QTableWidget, QPlainTextEdit, QLineEdit, QTextBrowser {
    background: #ffffff; border: 1px solid #e3e0da; border-radius: 6px;
    selection-background-color: #fde3d3; selection-color: #24221f; }
QTreeWidget::item, QListWidget::item { padding: 4px 2px; }
QTreeWidget::item:selected, QListWidget::item:selected { background: #fde3d3; color: #24221f; }
QHeaderView::section { background: #f6f5f2; border: none; border-bottom: 1px solid #e3e0da;
                       padding: 4px 6px; color: #6b665e; font-weight: 600; }
QLineEdit, QPlainTextEdit { padding: 6px; }
QLineEdit:focus, QPlainTextEdit:focus { border-color: #e8590c; }

QPushButton { background: #ffffff; border: 1px solid #d6d1c9; border-radius: 6px; padding: 5px 12px; }
QPushButton:hover { border-color: #e8590c; }
QPushButton:disabled { color: #b5b0a8; border-color: #e3e0da; }
QPushButton#danger { color: #c92a2a; }
QPushButton#danger:hover { border-color: #c92a2a; }

QTabWidget::pane { border: none; border-top: 1px solid #e3e0da; background: #ffffff; }
QTabBar::tab { background: transparent; padding: 7px 14px; color: #6b665e; border: none; }
QTabBar::tab:selected { color: #24221f; border-bottom: 2px solid #e8590c; font-weight: 600; }

QLabel#sectionTitle { font-size: 15px; font-weight: 700; padding: 2px 0 6px 0; }
QLabel#hint { color: #6b665e; }
QLabel#detected { color: #8a5a00; background: #fff4db; border-radius: 4px; padding: 4px 8px; }
QFrame#card { background: #ffffff; border: 1px solid #e3e0da; border-radius: 8px; }
QFrame#problem { background: #fff1f0; border: 1px solid #f5c2c0; border-radius: 6px; }
QStatusBar { background: #ffffff; border-top: 1px solid #e3e0da; color: #6b665e; }
QComboBox { background: #ffffff; border: 1px solid #d6d1c9; border-radius: 6px; padding: 4px 8px; }
QSpinBox { background: #ffffff; border: 1px solid #d6d1c9; border-radius: 6px; padding: 3px; }
QScrollArea { border: none; }
